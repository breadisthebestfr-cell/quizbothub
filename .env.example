# Spotify Developer credentials
# See README.md for step-by-step setup instructions

SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# ── Optional visual / behaviour tweaks ──────────────────────────────────────────────
# Typewriter speed (milliseconds per character; lower = faster)
# CHAR_DELAY_MS=15

# Extra pause on blank lines between verses (milliseconds)
# NEWLINE_PAUSE_MS=80

# Pixels between CRT scanlines (higher = less visible scanlines)
# SCANLINE_GAP=3

# Phosphor green colour (any CSS hex colour works)
# GREEN_COLOR=#00FF41
